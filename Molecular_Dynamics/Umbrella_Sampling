import numpy as np
import matplotlib.pyplot as plt

# Input file generated by WHAM.
# The first column contains the reaction coordinate (psi angle in degrees),
# and the second column contains the corresponding free energy in kcal/mol.
data_file = "delta_g.xvg"

# Read the first two columns of the WHAM output file.
# Lines starting with # or @ contain comments/metadata and are ignored.
data = np.loadtxt(data_file, comments=("#", "@"), usecols=(0, 1))

# Store the reaction coordinate (psi angle) and free-energy values
# in separate arrays for plotting.
psi = data[:, 0]
free_energy = data[:, 1]

# Plot the free-energy profile as a function of the reaction coordinate.
# Minima correspond to energetically favorable regions, whereas higher
# values indicate less favorable states or free-energy barriers.
plt.figure(figsize=(10, 8))
plt.plot(psi, free_energy)
plt.xlabel(r"$\psi$ (°)")
plt.ylabel("Free energy (kcal/mol)")
plt.savefig("WHAM_free_energy_psi.png", dpi=300, bbox_inches="tight")
plt.show()
