# # Standing Waves – Calibration Curve and Resonance Frequency

import numpy as np
import matplotlib.pyplot as plt

# Measurement data
y = np.array([32.85, 21.72, 24.4, 19.73, 28.25,
             30.7, 32.6, 22.6, 19.77, 17.26])
x = np.array([800, 1300, 1150, 1500, 1300, 900, 850, 1250, 1450, 1600])

# Calculating frequency
frequency = (348.71 * 10**(2)) / y

# Linear fit
p = np.polyfit(x, frequency, 1)
f = np.poly1d(p)

# Generating x-values for fitted line
x_fit = np.linspace(min(x), max(x), 300)

# Plot
plt.scatter(x, frequency, label="Measured values")
plt.plot(x_fit, f(x_fit), label="Linear fit")
plt.xlabel("Scale value")
plt.ylabel("Frequency")
plt.grid(True)
plt.legend()
plt.savefig("Calibration_curve.png", dpi=300, bbox_inches="tight")
plt.show()

# Fit function
print("Fit function:")
print(f)

# Resonance position
print("Resonance position:", f(1200))
